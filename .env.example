# Copy to .env (never commit .env). Paths are absolute. Put certificates in secrets/ (git-ignored).

# Aiven MySQL (TLS required; the JDBC URL is built in code from these parts)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL_CA_PATH=/path/to/secrets/aiven-ca.pem
# PKCS12 truststore made from the CA: keytool -importcert -alias aiven-ca -file aiven-ca.pem -keystore aiven-ca.p12 -storetype PKCS12
DB_TRUSTSTORE_PATH=/path/to/secrets/aiven-ca.p12
DB_TRUSTSTORE_PASSWORD=

# Aiven Kafka (client-certificate auth). Optional; the backend must start without it.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP=
KAFKA_SSL_CA_PATH=/path/to/secrets/aiven-ca.pem
KAFKA_SSL_CERT_PATH=/path/to/secrets/kafka-access-cert.pem
KAFKA_SSL_KEY_PATH=/path/to/secrets/kafka-access-key.pem

# Device registration: one-time pairing code entered on the phone
DEVICE_PAIRING_CODE=

# Admin (React dashboard) credential; store a bcrypt hash, not the password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Base64 32-byte AES-256 key for raw_payload field encryption
PAYLOAD_ENCRYPTION_KEY=

# Gmail (Android OAuth client; needs package name + signing SHA-1 in Google Cloud)
GOOGLE_OAUTH_CLIENT_ID=

# Ask AI (optional). Free key from https://aistudio.google.com/apikey; do not enable billing on it. Empty means built-in search only.
GEMINI_API_KEY=
#GEMINI_MODEL=gemini-flash-lite-latest
#AI_DAILY_LIMIT=150
